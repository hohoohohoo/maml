{
  "experiment_name": "gnn_maml_tsmc_process_sweep",
  "description": "TSMC Process GNN MAML architecture sweep (11D node features: 7 base + 4 process params)",
  "base_config": {
    "data_type": "cell",
    "graph_mode": "full_graph",
    "meta_lr": 0.0001,
    "innerdiv": 10,
    "total_iterations": 300000,
    "chunk_size": 100000,
    "K": 5,
    "tasks_per_meta_batch": 16,
    "inner_steps": 1,
    "gpu": 2,
    "pooling": "mean"
  },
  "sweep_params": {
    "conv_hidden_dim": [128],
    "num_conv_layers": [2],
    "fc_hidden_dim": [128, 256, 512],
    "num_fc_layers": [2]
  },
  "_comments": {
    "pooling_options": "mean, max, add, output (output-node-only)",
    "output_node_idx_note": "output_node_idx is now dynamically determined from topology cache (fallback default: 2)"
  }
}
