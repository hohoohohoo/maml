{
  "experiment_name": "gnn_validation_asap7_process_parasitic_sweep",
  "description": "GNN topology validation sweep for ASAP7 Process dataset with parasitic cap (intra_topology / topology_agnostic) with 12D node features (7 base + 4 process params + parasitic_cap)",
  "base_config": {
    "model_type": "maml",
    "data_type": "cell",
    "graph_mode": "full_graph",
    "mode": "interpolation",
    "total_points": 61,
    "num_test_samples": 10000,
    "num_iterations": 300000,
    "save_results": true,
    "filter_continuous": true,
    "continuity_threshold": 0.18,
    "gpu": 6
  },
  "sweep_params": {
    "experiment": ["intra_topology", "topology_agnostic"],
    "conv_hidden_dim": [64],
    "num_conv_layers": [2],
    "fc_hidden_dim": [256, 512],
    "num_fc_layers": [2]
  },
  "maml_config": {
    "innerdiv": 10,
    "tasks_per_meta_batch": 16,
    "inner_steps": 1
  },
  "_comments": {
    "node_features": "12D: 7 base electrical + param_a + param_b + param_c + temperature + parasitic_cap",
    "dataset_path": "dataset_temp_process/with_parasitic_cap/",
    "model_path": "gnn_maml_asap7_process_parasitic_final/"
  }
}
