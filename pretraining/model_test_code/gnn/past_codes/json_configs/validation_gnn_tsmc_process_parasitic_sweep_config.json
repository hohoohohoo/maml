{
  "experiment_name": "gnn_validation_tsmc_process_parasitic_sweep",
  "description": "GNN topology validation sweep for TSMC Process dataset with parasitic cap (intra_topology / topology_agnostic) with 12D node features (7 base + 4 process params + parasitic_cap)",
  "base_config": {
    "model_type": "maml",
    "data_type": "cell",
    "graph_mode": "stage_aware",
    "mode": "interpolation",
    "total_points": 61,
    "num_test_samples": 10000,
    "num_iterations": 300000,
    "save_results": true,
    "filter_continuous": true,
    "continuity_threshold": 0.18,
    "pooling": "output",
    "gpu": 3
  },
  "sweep_params": {
    "experiment": ["topology_agnostic"],
    "conv_hidden_dim": [32, 64],
    "num_conv_layers": [2],
    "fc_hidden_dim": [256,512],
    "num_fc_layers": [2]
  },
  "maml_config": {
    "innerdiv": 10,
    "tasks_per_meta_batch": 16,
    "inner_steps": 1
  },
  "_comments": {
    "node_features": "12D: 7 base electrical + param_a + param_b + param_c + temperature + parasitic_cap",
    "dataset_path": "dataset_TSMC_GNN_unified/with_parasitic_cap/",
    "model_path": "gnn_maml_tsmc_parasitic_final/",
    "pooling_options": "mean, max, add, output (output-node-only)"
  }
}
