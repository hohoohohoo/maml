{
  "experiment_name": "gnn_validation_tsmc_sweep",
  "description": "GNN validation sweep for TSMC dataset across corner-temperature combinations and architectures",
  "base_config": {
    "model_type": "maml",
    "data_type": "cell",
    "graph_mode": "stage_aware",
    "mode": "interpolation",
    "total_points": 61,
    "num_test_samples": 10000,
    "num_iterations": 30000,
    "save_results": true,
    "filter_continuous": false,
    "continuity_threshold": 0.18,
    "gpu": 2
  },
  "sweep_params": {
    "corner": ["FF"],
    "temperature": [0],
    "conv_hidden_dim": [128,256],
    "num_conv_layers": [2, 3],
    "fc_hidden_dim": [32,64,128,256,512],
    "num_fc_layers": [2]
  },
  "maml_config": {
    "innerdiv": 10,
    "tasks_per_meta_batch": 16,
    "inner_steps": 1
  }
}
