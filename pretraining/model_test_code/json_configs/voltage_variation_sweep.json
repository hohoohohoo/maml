{
  "experiment_name": "voltage_variation_validation_sweep",
  "description": "Voltage variation validation for ASAP7 and TSMC across multiple configurations",
  "base_config": {
    "mode": "interpolation",
    "gpu_id": "7",
    "num_test_samples": 100000,
    "save_results": true,
    "model_framework": "maml"
  },
  "sweep_params": {
    "pdk": ["tsmc"],
    "data_type":["transition","cell"]
  },
  "pdk_specific": {
    "asap7": {
      "corner": ["FF", "SS", "TT"],
      "cell_type": ["lvt", "rvt","slvt","sram"]
    },
    "tsmc": {
      "corner": ["ff", "ss", "tt"],
      "temperatures": [["0", "25", "50", "75", "100"]]
    }
  },
  "model_params": {
    "maml": {
      "layer_length": 40,
      "innerdiv": 100,
      "asap7": {
        "inner_step": 1,
        "meta": 32,
        "num_iterations" : 100000
      },
      "tsmc": {
        "inner_step": 1,
        "meta": 32,
        "num_iterations": 30000
      }
    }
  }
}
